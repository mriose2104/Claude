<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AppUsageMonitor.Dashboard</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- WPF necesita resolver el idioma "en-US" (FrameworkElement.Language)
         para dibujar varios controles (DataGrid, ComboBox, TextBox editable);
         InvariantGlobalization=true lo bloquea y causaba un crash
         ("Cannot find non-neutral culture related to 'en-us'") justo al
         mostrar la pestana de Historial. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppUsageMonitor.Database\AppUsageMonitor.Database.csproj" />
    <ProjectReference Include="..\AppUsageMonitor.Reports\AppUsageMonitor.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
