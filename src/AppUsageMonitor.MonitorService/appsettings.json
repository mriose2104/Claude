{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Monitoring": {
    "PollIntervalSeconds": 5,
    "ExcludedProcessNames": [
      "explorer",
      "ApplicationFrameHost",
      "ShellExperienceHost",
      "SearchHost",
      "SearchApp",
      "TextInputHost",
      "StartMenuExperienceHost",
      "LockApp",
      "dwm",
      "csrss",
      "SystemSettings",
      "PickerHost",
      "WidgetService",
      "Widgets"
    ]
  }
}
