<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AppUsageMonitor.MonitorService</RootNamespace>
    <UserSecretsId>appusagemonitor-service</UserSecretsId>
    <!-- WinExe (no Exe): corre como tarea de la sesion del usuario sin
         asignar consola. Un servicio LocalSystem (Sesion 0) no puede ver las
         ventanas de la sesion interactiva por el aislamiento de Windows, asi
         que este monitor se instala como tarea programada al inicio de
         sesion (ver installer/install-monitor-task.ps1), no como servicio
         del Administrador de control de servicios. -->
    <OutputType>WinExe</OutputType>
    <!-- El monitor necesita leer el nombre del usuario y el titulo de
         ventana de otros procesos: requiere APIs de Windows. -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppUsageMonitor.Database\AppUsageMonitor.Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
